# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Project Settings → API Keys → anon / publishable key. Safe to expose.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Project Settings → API Keys → service_role key. SERVER ONLY — never prefix
# this with NEXT_PUBLIC_. Used by admin actions that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── App ─────────────────────────────────────────────────────────────────────
# Used for auth redirect URLs. On Vercel this is filled in automatically from
# VERCEL_URL, so you only need it for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
